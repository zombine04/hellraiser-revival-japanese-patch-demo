    {
      "namespace": "ST_VO_Mission01",
      "namespace_hash": 994771790,
      "key": "VX_Mission01_01Prison_CellAwake_5szf_Marlowe",
      "key_hash": 3838652362,
      "source_hash": 2298706914,
      "ja": "数日前、ジェネシス・コンフィギュレーションが我々の手元から消えた。",
      "status": "needs_review",
      "review_note": "字幕表示の試作。正式訳は用語集と場面の照合後に確定する。",
      "placeholders": [],
      "tags": []
    },
    {
      "namespace": "ST_VO_Mission01",
      "namespace_hash": 994771790,
      "key": "VX_Mission01_01Prison_CellAwake_dxWo_Keller",
      "key_hash": 4026049189,
      "source_hash": 2655718605,
      "ja": "ああ！ そこの独房、椅子の上だ。",
      "status": "needs_review",
      "review_note": "字幕表示の試作。正式訳は用語集と場面の照合後に確定する。",
      "placeholders": [],
      "tags": []
